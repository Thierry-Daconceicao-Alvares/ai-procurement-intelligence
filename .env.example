# Copy to .env (ignored by git) and fill in. Every setting is optional.

# Gemini API key, for live explanations of alerts and briefings of views.
GEMINI_API_KEY=
# Gemini model used for live explanations.
GENERATION_MODEL=gemini-3.5-flash-lite
# true: each visitor's decisions stay in memory, for their session only.
PUBLIC_DEMO=false
# Folder of data/snapshot, data/marts and data/cache (default: data/ in the repository).
# DATA_DIR=
# Memory DuckDB may use while building the warehouse (it spills to disk beyond).
# DUCKDB_MEMORY_LIMIT=4GB
