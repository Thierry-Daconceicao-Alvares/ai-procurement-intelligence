model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder", "Contracts", "ContractHolders", "Buyers", "Suppliers", "CPV", "Alerts", "CategoryMarkets", "Dates"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Contracts
ref table ContractHolders
ref table Buyers
ref table Suppliers
ref table CPV
ref table Alerts
ref table CategoryMarkets
ref table Dates
ref table Measures
