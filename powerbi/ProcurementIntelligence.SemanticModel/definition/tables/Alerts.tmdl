/// One alert to review: a risk indicator computed from the published data, with its priority, title and recommended action. The evidence (JSON) stays in the marts.
table Alerts
	lineageTag: 905ca483-f457-5077-8a94-0923b01c07fe

	column alert_id
		dataType: string
		lineageTag: 32229e5c-b524-538b-8d0c-2cd56d27041d
		summarizeBy: none
		sourceColumn: alert_id

		annotation SummarizationSetBy = Automatic

	column alert_type
		dataType: string
		lineageTag: 03808993-e197-5b83-aaa1-bb208014c1e7
		summarizeBy: none
		sourceColumn: alert_type

		annotation SummarizationSetBy = Automatic

	column category
		dataType: string
		lineageTag: 18cd16d6-508d-5bcc-8b0d-b0545d886e0a
		summarizeBy: none
		sourceColumn: category

		annotation SummarizationSetBy = Automatic

	column label
		dataType: string
		lineageTag: 3e0af23c-e71f-5cc7-ba1d-9f9ffc20c0de
		summarizeBy: none
		sourceColumn: label

