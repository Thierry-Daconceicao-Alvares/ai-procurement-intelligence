	partition Alerts = m
		mode: import
		source =
				let
				    Root = Text.TrimEnd(DataFolder, "\") & "\",
				    Files = Folder.Files(Root),
				    InRoot = Table.SelectRows(Files, each Text.Lower([Folder Path]) = Text.Lower(Root)),
				    AlertFiles = Table.SelectRows(Files, each Text.Lower([Folder Path]) = Text.Lower(Root & "alerts\") and Text.Lower([Extension]) = ".parquet"),
				    Alerts = Table.Combine(List.Transform(AlertFiles[Content], each Parquet.Document(_))),
				    WithoutEvidence = Table.RemoveColumns(Alerts, {"evidence"}),
				    Buyers = Table.SelectRows(Table.SelectColumns(Parquet.Document(InRoot{[Name = "buyers.parquet"]}[Content]), {"buyer_siret", "buyer_name"}), each [buyer_siret] <> null),
				    Suppliers = Table.SelectColumns(Parquet.Document(InRoot{[Name = "suppliers.parquet"]}[Content]), {"holder_key", "supplier_name"}),
				    WithBuyer = Table.NestedJoin(WithoutEvidence, {"buyer_siret"}, Buyers, {"buyer_siret"}, "Buyer", JoinKind.LeftOuter),
				    BuyerName = Table.ExpandTableColumn(WithBuyer, "Buyer", {"buyer_name"}),
				    WithSupplier = Table.NestedJoin(BuyerName, {"holder_key"}, Suppliers, {"holder_key"}, "Supplier", JoinKind.LeftOuter),
				    SupplierName = Table.ExpandTableColumn(WithSupplier, "Supplier", {"supplier_name"}),
				    Typed = Table.TransformColumnTypes(SupplierName, {{"buyer_name", type text}, {"supplier_name", type text}})
				in
				    Typed

	annotation PBI_ResultType = Table
