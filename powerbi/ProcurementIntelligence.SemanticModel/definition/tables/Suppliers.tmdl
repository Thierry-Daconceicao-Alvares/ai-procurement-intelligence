	partition Suppliers = m
		mode: import
		source =
				let
				    Root = Text.TrimEnd(DataFolder, "\") & "\",
				    Files = Folder.Files(Root),
				    InRoot = Table.SelectRows(Files, each Text.Lower([Folder Path]) = Text.Lower(Root)),
				    Suppliers = Parquet.Document(InRoot{[Name = "suppliers.parquet"]}[Content]),
				    Profiles = Parquet.Document(InRoot{[Name = "supplier_profiles.parquet"]}[Content]),
				    Joined = Table.NestedJoin(Suppliers, {"holder_key"}, Profiles, {"holder_key"}, "Profile", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Joined, "Profile", {"segment", "contracts", "buyers", "divisions", "top_buyer_share", "median_distance_km", "single_bid_share", "framework_share"}, {"segment", "profile_contracts", "profile_buyers", "profile_divisions", "top_buyer_share", "median_distance_km", "profile_single_bid_share", "profile_framework_share"}),
				    Typed = Table.TransformColumnTypes(Expanded, {{"segment", type text}, {"profile_contracts", Int64.Type}, {"profile_buyers", Int64.Type}, {"profile_divisions", Int64.Type}, {"top_buyer_share", type number}, {"median_distance_km", type number}, {"profile_single_bid_share", type number}, {"profile_framework_share", type number}})
				in
				    Typed

	annotation PBI_ResultType = Table
